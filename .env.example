# ---------------------------------------------------------------
# Build-time variables (public, embedded in the static site).
# Set in Cloudflare Pages → Settings → Variables and Secrets
# (Production and Preview), or in a local .env for development.
# ---------------------------------------------------------------

# Where the RFQ form posts. Default: the Pages Function at /api/rfq.
# Alternatives: https://api.web3forms.com/submit  or  https://formspree.io/f/<form-id>
PUBLIC_RFQ_ENDPOINT=/api/rfq

# Cloudflare Turnstile site key (Cloudflare dashboard → Turnstile). Leave empty to disable.
PUBLIC_TURNSTILE_SITE_KEY=

# Only when PUBLIC_RFQ_ENDPOINT points to Web3Forms.
PUBLIC_WEB3FORMS_ACCESS_KEY=

# ---------------------------------------------------------------
# Runtime secrets for the Pages Function (functions/api/rfq.ts).
# Set as encrypted secrets in Cloudflare Pages; for local testing
# with `npx wrangler pages dev dist`, put them in .dev.vars.
# ---------------------------------------------------------------
# RESEND_API_KEY=
# TURNSTILE_SECRET_KEY=
# RFQ_TO=sales@chalybesteel.com
# RFQ_FROM=Chalybe Steel RFQ <rfq@chalybesteel.com>
