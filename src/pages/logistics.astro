---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/ui/PageHero.astro";
import CtaBand from "@/components/ui/CtaBand.astro";
import Photo from "@/components/ui/Photo.astro";
import { photos } from "@/config/images";

const incoterms = [
  {
    code: "FOB",
    name: "Free On Board",
    d: "Goods loaded on the vessel at the named port of shipment. Buyer arranges and pays ocean freight and insurance.",
  },
  {
    code: "CFR",
    name: "Cost and Freight",
    d: "We arrange and pay ocean freight to the named port of destination. Risk transfers when goods are on board.",
  },
  {
    code: "CIF",
    name: "Cost, Insurance and Freight",
    d: "As CFR, with cargo insurance arranged by us for the voyage to the named destination port.",
  },
  {
    code: "DAP",
    name: "Delivered at Place",
    d: "Delivered to the named place — a yard, base or project site — ready for unloading. Import clearance and duties remain with the buyer.",
  },
];

const modes = [
  {
    t: "Containerised",
    d: "Suited to tubing, shorter range lengths, accessories and smaller quantities. Open-top or flat-rack containers where length requires.",
  },
  {
    t: "Break-bulk",
    d: "Suited to larger casing volumes and R3 lengths. Pipe is bundled or loose-stowed with dunnage and securing per the stowage plan.",
  },
  {
    t: "Inland & on-site",
    d: "Road or rail on-carriage from the discharge port to a pipe yard, logistics base or project site under DAP.",
  },
];

const docs = [
  "Commercial invoice and packing list",
  "Bill of lading or other transport document",
  "Certificate of origin",
  "Mill test certificates (EN 10204 3.1 / 3.2)",
  "Third-party inspection reports, where ordered",
  "Pipe tally with heat and joint numbers",
  "Insurance certificate (CIF)",
  "Other documents per letter of credit or destination requirements",
];
---

<BaseLayout
  title="Logistics & Delivery"
  description="Shipping of API 5CT casing and tubing on FOB, CFR, CIF and DAP terms: containerised or break-bulk, export documentation, and delivery to port or project site."
>
  <PageHero
    eyebrow="Logistics"
    title="Delivered to port or project site."
    lead="We coordinate freight from the mill to your nominated destination, with the export documentation your import, finance and quality teams need."
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "Logistics" }]}
  />

  <section class="py-16 sm:py-20" aria-labelledby="incoterms">
    <div class="container-site">
      <p class="eyebrow text-forge-ink">Incoterms® 2020</p>
      <h2 id="incoterms" class="mt-3 text-3xl font-bold">
        Commercial terms
      </h2>
      <p class="mt-4 max-w-2xl text-steel-dark">
        Quotations are made on the Incoterm you specify. Other terms can be considered on request.
      </p>
      <dl class="mt-10 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {incoterms.map((i) => (
          <div class="bg-white p-7">
            <dt>
              <span class="block font-mono text-3xl font-medium text-graphite">{i.code}</span>
              <span class="mt-1 block text-sm font-semibold text-forge-ink">{i.name}</span>
            </dt>
            <dd class="mt-4 text-sm leading-relaxed text-steel-dark">{i.d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="bg-ink py-16 text-paper sm:py-20" aria-labelledby="shipping">
    <div class="container-site">
      <p class="eyebrow text-forge">Shipping</p>
      <h2 id="shipping" class="mt-3 text-3xl font-bold">
        Mode of transport
      </h2>
      <div class="mt-10 overflow-hidden border border-white/10" aria-hidden="true">
        <svg viewBox="0 0 1200 120" class="h-auto w-full" fill="none">
          <path d="M40 60H1160" stroke="#6B7480" stroke-dasharray="6 6"></path>
          {[
            [80, "MILL"],
            [420, "PORT OF LOADING"],
            [780, "PORT OF DISCHARGE"],
            [1120, "SITE"],
          ].map(([x, label]) => (
            <g>
              <circle cx={x} cy="60" r="12" fill="#121417" stroke="#F3F2EF" stroke-width="1.5" />
              <circle cx={x} cy="60" r="4.5" fill="#D9622B" />
              <text
                x={x}
                y="100"
                text-anchor="middle"
                font-family="IBM Plex Mono, monospace"
                font-size="13"
                fill="#9AA3AD"
                letter-spacing="1.5"
              >
                {label}
              </text>
            </g>
          ))}
        </svg>
      </div>
      <ul class="mt-px grid gap-px overflow-hidden border border-white/10 bg-white/10 md:grid-cols-3">
        {modes.map((m) => (
          <li class="bg-ink p-7">
            <h3 class="text-xl font-semibold">{m.t}</h3>
            <p class="mt-3 text-sm leading-relaxed text-steel-light">{m.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-16 sm:py-20" aria-labelledby="documents">
    <div class="container-site grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow text-forge-ink">Export documentation</p>
        <h2 id="documents" class="mt-3 text-3xl font-bold">
          Documents issued with each shipment
        </h2>
        <p class="mt-4 text-steel-dark">
          Document sets are agreed at order stage and checked against the letter of credit or
          payment terms before shipment.
        </p>
      </div>
      <ul class="grid gap-px self-start overflow-hidden border border-line bg-line sm:grid-cols-2 lg:col-span-7">
        {docs.map((d) => (
          <li class="flex items-start gap-3 bg-white p-4 text-sm">
            <span class="mt-1.5 h-px w-3 shrink-0 bg-forge" aria-hidden="true" />
            {d}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {photos.logistics.enabled && (
    <figure class="container-site pb-16">
      <Photo photo={photos.logistics} class="aspect-[21/9] border border-line" />
    </figure>
  )}
  <CtaBand
    title="Tell us where the pipe needs to be."
    text="Include the destination port or site, required delivery date and preferred Incoterm with your enquiry."
  />
</BaseLayout>
