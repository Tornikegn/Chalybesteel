---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/ui/PageHero.astro";
import RfqForm from "@/components/RfqForm.astro";
import Todo from "@/components/Todo.astro";
import { site, rfqMailto } from "@/config/site";

const checklist = [
  "Product, OD and weight or wall thickness",
  "Grade, connection and PSL",
  "Range length and end finish",
  "Quantity and unit",
  "Destination, delivery date and Incoterm",
  "Inspection and certificate requirements",
];
---

<BaseLayout
  title="Request a Quote"
  description="Send an RFQ for API 5CT seamless casing, tubing or accessories. Specify size, weight, grade, connection, PSL, quantity and destination, or email sales@chalybesteel.com."
>
  <PageHero
    eyebrow="Request a quote · Contact"
    title="Request a quote"
    lead="Send your requirement and we will review the specification, select a qualified mill and return a quotation."
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "Request a Quote" }]}
  />

  <section class="py-14 sm:py-20">
    <div class="container-site grid gap-12 lg:grid-cols-12">
      <div class="relative lg:col-span-8">
        <div class="border border-line bg-paper sm:bg-white sm:p-10">
          <RfqForm />
        </div>
      </div>

      <aside class="space-y-8 lg:col-span-4" aria-label="Contact">
        <div class="bg-ink p-7 text-paper">
          <h2 class="eyebrow text-forge">Contact</h2>
          <p class="mt-4 text-sm text-steel-light">Sales and RFQs</p>
          <a
            href={rfqMailto}
            class="mt-1 block font-mono text-lg break-all text-paper hover:text-forge"
          >
            {site.email}
          </a>
          {site.phone && <p class="mt-3 font-mono text-paper">{site.phone}</p>}
          <p class="mt-6 border-t border-white/10 pt-6 text-sm text-steel-light">
            We respond to RFQs within one business day.
            <Todo note="confirm response time" tone="dark" />
          </p>
        </div>

        <div class="border border-line bg-white p-7">
          <h2 class="text-lg font-bold">For a fast, accurate quote</h2>
          <ul class="mt-4 space-y-2.5 text-sm text-steel-dark">
            {checklist.map((c) => (
              <li class="flex gap-3">
                <span class="mt-2 h-px w-3 shrink-0 bg-forge" aria-hidden="true" />
                {c}
              </li>
            ))}
          </ul>
          <p class="mt-6 text-sm text-steel-dark">
            Prefer email? Send the same details and any specification sheets to{" "}
            <a href={rfqMailto} class="link">
              {site.email}
            </a>
            .
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
