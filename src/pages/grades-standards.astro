---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/ui/PageHero.astro";
import CtaBand from "@/components/ui/CtaBand.astro";
import Verify from "@/components/Verify.astro";
import VerifyLegend from "@/components/VerifyLegend.astro";

const grades = (await getCollection("grades")).map((g) => ({ id: g.id, ...g.data }));
const groups = [1, 2, 3, 4].map((n) => ({ n, rows: grades.filter((g) => g.group === n) }));
const groupNote: Record<number, string> = {
  1: "General-purpose grades. All carbon steel, with N80 supplied as Type 1 or quenched & tempered (Q).",
  2: "Restricted-yield grades with controlled hardness, intended for sour service, plus chromium grades for CO₂ service.",
  3: "High-strength grade for deep, high-pressure wells in non-sour service.",
  4: "Highest-strength API 5CT grade for ultra-deep and HPHT casing.",
};

const standards = [
  {
    code: "API 5CT / ISO 11960",
    title: "Casing and tubing",
    text: "Specifies requirements for seamless and welded steel casing, tubing, coupling stock and accessories, including grades, dimensions, testing, inspection and marking. Our supply is seamless only.",
  },
  {
    code: "API 5B",
    title: "Threading, gauging and inspection",
    text: "Covers dimensions, gauging and thread inspection for API round-thread (STC, LTC, NUE, EUE) and buttress (BTC) connections.",
  },
  {
    code: "NACE MR0175 / ISO 15156",
    title: "Sour service materials",
    text: "Sets requirements for metallic materials in H₂S-containing environments. Grade selection for sour wells is confirmed against this standard and the operator's own specification.",
  },
];
---

<BaseLayout
  title="API 5CT Grades & Standards"
  description="API 5CT casing and tubing grade groups 1–4: H40, J55, K55, N80, R95, M65, L80, C90, T95, C110, P110, Q125 — yield and tensile strength, colour-band identification and typical use."
>
  <PageHero
    eyebrow="API 5CT · ISO 11960 · API 5B · NACE MR0175"
    title="Grades & standards"
    lead="API 5CT grade groups with mechanical properties, colour-band identification and typical applications. Use this as a reference when preparing an enquiry; the purchase order and the current API 5CT edition govern."
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "Grades & Standards" }]}
  />

  <section class="py-16 sm:py-20" aria-labelledby="grade-table">
    <div class="container-site">
      <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <p class="eyebrow text-forge-ink">API 5CT grade groups</p>
          <h2 id="grade-table" class="mt-3 text-3xl font-bold">
            Mechanical properties
          </h2>
        </div>
        <VerifyLegend />
      </div>

      <div class="mt-8 space-y-12">
        {groups.map((g) => (
          <section aria-labelledby={`group-${g.n}`}>
            <div class="flex flex-col gap-1 border-b-2 border-graphite pb-3 sm:flex-row sm:items-baseline sm:gap-4">
              <h3
                id={`group-${g.n}`}
                class="font-mono text-sm font-semibold tracking-wider uppercase"
              >
                Group {g.n}
              </h3>
              <p class="text-sm text-steel-dark">{groupNote[g.n]}</p>
            </div>
            <div
              class="overflow-x-auto bg-white"
              tabindex="0"
              role="region"
              aria-labelledby={`group-${g.n}`}
            >
              <table class="num w-full min-w-[56rem] text-left text-sm">
                <thead>
                  <tr class="border-b border-line font-mono text-xs text-steel-dark">
                    <th scope="col" class="px-3 py-3 font-medium">
                      Grade
                    </th>
                    <th scope="col" class="px-3 py-3 font-medium">
                      Type
                    </th>
                    <th scope="col" class="px-3 py-3 font-medium">
                      Yield min
                      <br />
                      ksi / MPa
                    </th>
                    <th scope="col" class="px-3 py-3 font-medium">
                      Yield max
                      <br />
                      ksi / MPa
                    </th>
                    <th scope="col" class="px-3 py-3 font-medium">
                      Tensile min
                      <br />
                      ksi / MPa
                    </th>
                    <th scope="col" class="px-3 py-3 font-medium">
                      Colour band
                    </th>
                    <th scope="col" class="px-3 py-3 font-medium">
                      Typical use
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {g.rows.map((r) => (
                    <tr class="border-b border-line/70 align-top hover:bg-paper">
                      <th
                        scope="row"
                        class="px-3 py-3 font-mono text-base font-semibold whitespace-nowrap"
                      >
                        {r.grade}
                      </th>
                      <td class="px-3 py-3 whitespace-nowrap text-steel-dark">{r.type || "—"}</td>
                      <td class="px-3 py-3 font-mono whitespace-nowrap">
                        {r.yieldMinKsi} / {r.yieldMinMpa}
                        <Verify />
                      </td>
                      <td class="px-3 py-3 font-mono whitespace-nowrap">
                        {r.yieldMaxKsi} / {r.yieldMaxMpa}
                        <Verify />
                      </td>
                      <td class="px-3 py-3 font-mono whitespace-nowrap">
                        {r.tensileMinKsi} / {r.tensileMinMpa}
                        <Verify />
                      </td>
                      <td class="px-3 py-3">
                        <span class="flex items-center gap-2">
                          <span class="flex shrink-0 gap-0.5" aria-hidden="true">
                            {r.colours.map((c) => (
                              <svg width="7" height="20" viewBox="0 0 7 20">
                                <rect
                                  x="0.5"
                                  y="0.5"
                                  width="6"
                                  height="19"
                                  fill={c}
                                  stroke="#16191D"
                                  stroke-opacity="0.35"
                                />
                              </svg>
                            ))}
                          </span>
                          <span class="text-xs text-steel-dark">{r.colourBands.join(" + ")}</span>
                        </span>
                      </td>
                      <td class="max-w-xs px-3 py-3 text-steel-dark">{r.use}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        ))}
      </div>

      <div class="mt-8 grid gap-4 text-sm text-steel-dark md:grid-cols-2">
        <p>
          Strength values are specified minimums and maximums. Hardness limits, chemistry, impact
          toughness and heat-treatment requirements by grade and PSL are defined in API 5CT and
          confirmed on the mill test certificate.
        </p>
        <p>
          Colour-band identification per API 5CT applies to pipe and couplings; couplings may carry
          the grade colour over the full surface. Additional client colour codes can be added on
          request.
        </p>
      </div>
      <p class="mt-6 border-l-2 border-forge bg-white p-4 text-sm text-steel-dark">
        Indicative. Final specification per purchase order and the current edition of API 5CT.
      </p>
    </div>
  </section>

  <section class="border-t border-line bg-white py-16 sm:py-20" aria-labelledby="standards">
    <div class="container-site">
      <p class="eyebrow text-forge-ink">Related standards</p>
      <h2 id="standards" class="mt-3 text-3xl font-bold">
        Standards we work to
      </h2>
      <ul class="mt-10 grid gap-px overflow-hidden border border-line bg-line md:grid-cols-3">
        {standards.map((s) => (
          <li class="bg-white p-7">
            <p class="font-mono text-sm font-semibold text-forge-ink">{s.code}</p>
            <h3 class="mt-2 text-xl font-semibold">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-steel-dark">{s.text}</p>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-sm text-steel-dark">
        Chalybe Steel is a trading company and is not an API-licensed manufacturer. Product is
        manufactured by mills licensed to the applicable API specification.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
