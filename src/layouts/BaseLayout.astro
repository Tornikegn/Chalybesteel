---
import "@/styles/global.css";
import SEO from "@/components/SEO.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { site } from "@/config/site";
import { useTranslations } from "@/i18n";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const props = Astro.props;
const locale = Astro.currentLocale ?? "en";
const t = useTranslations(locale);
const { cloudflareToken, plausibleDomain } = site.analytics;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#121417" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO {...props} />
    {cloudflareToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cloudflareToken })}
      />
    )}
    {plausibleDomain && (
      <script
        is:inline
        defer
        data-domain={plausibleDomain}
        src="https://plausible.io/js/script.js"
      />
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only z-100 rounded-sm bg-forge px-4 py-2 font-semibold text-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t("skip")}
    </a>
    <Header />
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
