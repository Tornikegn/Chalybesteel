# Cloudflare Pages headers. https://developers.cloudflare.com/pages/configuration/headers/
# If you enable analytics in src/config/site.ts, add its origin to script-src and connect-src:
#   Cloudflare Web Analytics: https://static.cloudflareinsights.com (script) https://cloudflareinsights.com (connect)
#   Plausible:                https://plausible.io (script and connect)
# If PUBLIC_RFQ_ENDPOINT points to Web3Forms or Formspree, add https://api.web3forms.com or https://formspree.io to connect-src and form-action.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://challenges.cloudflare.com; form-action 'self' mailto:; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=604800

